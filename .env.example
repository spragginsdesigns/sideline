# --- AI (required for the AI features) ---
OPENAI_API_KEY=
# Model for reading messages, writing nudges and the treasurer agent.
SIDELINE_MODEL=gpt-5.6-luna

# --- PayPal (optional: without these the app runs a local PayPal simulator) ---
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or production
PAYPAL_ENV=sandbox
# Webhook id from the developer dashboard, subscribed to INVOICING.INVOICE.PAID,
# INVOICING.INVOICE.CANCELLED and PAYMENT.PAYOUTS-ITEM.* at <your url>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# Optional: the merchant email shown as the invoicer
PAYPAL_INVOICER_EMAIL=

# --- AG Studio (optional) ---
# Without a key the Studio dashboard runs in trial mode (a watermark outside localhost).
# Free 45-day trial key: https://www.ag-grid.com/studio/react/enterprise-licence/
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Caps on the Studio agents' model use, so a public demo is not a free model endpoint.
# In memory, per server process. One question is roughly 10 to 25 turns.
SIDELINE_AI_TURNS_PER_VISITOR_PER_MINUTE=60
SIDELINE_AI_TURNS_PER_MINUTE=240
SIDELINE_AI_TURNS_PER_DAY=8000
SIDELINE_AI_TOKENS_PER_DAY=40000000

# --- App ---
# Public base URL, used in pay links and QR codes
SIDELINE_PUBLIC_URL=http://localhost:3000
# Team's time zone, so "due Friday" resolves to the right Friday
SIDELINE_TIMEZONE=America/Los_Angeles
# Where the JSON ledger is stored (default ./.data)
SIDELINE_DATA_DIR=
